{
  "manifest_version": 3,
  "name": "TabSync",
  "version": "0.1.0",
  "description": "Save, restore, and sync tab-group workspaces across devices via your Google account.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "public/icons/16.png",
    "32": "public/icons/32.png",
    "48": "public/icons/48.png",
    "128": "public/icons/128.png"
  },
  "action": {
    "default_title": "TabSync — quick save",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "public/icons/16.png",
      "32": "public/icons/32.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "identity",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": ["https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "467993632375-csgjuc2d8jbgu6v7cgf5i481m36vv047.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Open TabSync quick-save"
    },
    "open-side-panel": {
      "suggested_key": { "default": "Ctrl+Shift+O", "mac": "Command+Shift+O" },
      "description": "Open TabSync side panel"
    },
    "restore-last": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Restore the most recent workspace"
    }
  }
}
